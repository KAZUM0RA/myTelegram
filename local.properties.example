# ─────────────────────────────────────────────────────────────────
# ШАБЛОН локальних секретів.
#
# Скопіюй у local.properties і заповни реальними значеннями:
#     cp local.properties.example local.properties
#
# local.properties у .gitignore — його НІКОЛИ не буде закомічено.
# Цей файл (.example) навпаки — трекається, щоб було видно,
# які саме ключі потрібні для збірки.
# ─────────────────────────────────────────────────────────────────

# Шлях до Android SDK (потрібен тільки для локальної збірки в
# Android Studio; у GitHub Actions визначається автоматично).
#sdk.dir=C\:\Users\user\AppData\Local\Android\Sdk

# Дані застосунку з https://my.telegram.org -> API development tools
# Використовуються при збірці, підставляються у BuildConfig (Частина 2).
TELEGRAM_APP_ID=0
TELEGRAM_APP_HASH=

# ─────────────────────────────────────────────────────────────────
# УВАГА: ключ Anthropic API тут НЕ зберігається.
# Він вводиться користувачем у налаштуваннях застосунку і лежить
# зашифрованим на пристрої (Частина 4). У збірку не потрапляє —
# інакше будь-хто, хто дістане APK, витягне ключ.
# ─────────────────────────────────────────────────────────────────
